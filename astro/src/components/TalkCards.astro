---
import { getCollection } from 'astro:content';
import { formatDate, url, type Entry } from '../lib/site';

interface Props {
  talks: Extract<Entry, { collection: 'talks' }>[];
}

const { talks } = Astro.props;
const authors = new Map((await getCollection('authors')).map((a) => [a.id, a.data]));
// Like the Jekyll layouts, only a single author id gets a name on the card.
const nameOf = (author: unknown) => (typeof author === 'string' ? authors.get(author)?.name : undefined);
---

<section class="video-list">
  {
    talks.map((talk) => (
      <div class="card">
        <a href={url(talk.data.permalink)}>
          <img loading="lazy" src={`https://img.youtube.com/vi/${talk.data.youtubeId}/hqdefault.jpg`} alt="" />
        </a>
        <div class="card-body">
          <a href={url(talk.data.permalink)}>
            <h5 class="card-title">{talk.data.title}</h5>
          </a>
          <div class="card-content">
            {nameOf(talk.data.author) && <div>{nameOf(talk.data.author)}</div>}
            <div>{formatDate(talk.data.date)}</div>
          </div>
        </div>
      </div>
    ))
  }
</section>

<style>
  .video-list {
    display: grid;
    justify-content: center;
    align-content: center;
    gap: 32px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .card {
    width: 100%;
  }

  .card img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    padding: 0;
  }

  .card-content {
    display: flex;
    justify-content: space-between;
    font-size: 0.8em;
  }

  .card-title {
    text-overflow: ellipsis;
    overflow: hidden;
    display: -webkit-box !important;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    white-space: normal;
  }
</style>
