---
import { getCollection } from 'astro:content';
import { authorsOf, excerpt, readingMinutes, url, type Entry } from '../lib/site';

function initials(name?: string) {
  if (!name) return '';
  return name
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}

interface Props {
  articles: Extract<Entry, { collection: 'articles' }>[];
  page: number;
  totalPages: number;
}

const { articles, page, totalPages } = Astro.props;
const pagePath = (n: number) => (n === 1 ? '/' : `/blog/page${n}/`);
const labels = new Map((await getCollection('topics')).map((topic) => [topic.id, topic.data.label]));
const teasers = await Promise.all(
  articles.map(async (article) => ({
    article,
    authors: await authorsOf(article),
    excerpt: await excerpt(article),
    minutes: readingMinutes(article.body),
  })),
);
---

<div class="teasers">
  {
    teasers.map(({ article, authors, excerpt, minutes }) => (
      <article class="teaser">
        <time class="teaser-date" datetime={article.data.date.toISOString().slice(0, 10)}>
          {article.data.date.toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}
        </time>
        <div>
          <h2>
            <a href={url(article.data.permalink)}>{article.data.title}</a>
          </h2>
          <div class="excerpt" set:html={excerpt} />
          <p class="teaser-meta">
            {article.data.language && <span class="lang">{article.data.language}</span>}
            {article.data.topics.map((topic) => (
              <a href={`/tags/#${topic}`}>{labels.get(topic) ?? topic}</a>
            ))}
            {minutes && <span>{minutes} min</span>}
          </p>
        </div>
        {authors.length > 0 && (
          <div class="teaser-avatars">
            {authors.slice(0, 3).map((author) => (
              author.avatar
                ? <img src={author.avatar} alt={author.name ?? ''} />
                : <span class="avatar-fallback" title={author.name}>{initials(author.name)}</span>
            ))}
            {authors.length > 3 && <span class="avatar-fallback">+{authors.length - 3}</span>}
          </div>
        )}
      </article>
    ))
  }
</div>

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Articles">
      <div>
        {page > 1 && <a href={pagePath(page - 1)}>Previous</a>}
      </div>
      <span>{page} / {totalPages}</span>
      <div>
        {page < totalPages && <a href={pagePath(page + 1)}>Next</a>}
      </div>
    </nav>
  )
}
