---
import { formatDate, type Author } from '../lib/site';

interface Props {
  authors?: Author[];
  date: Date;
  language?: string;
  minutes?: number;
}

const { authors = [], date, language, minutes } = Astro.props;
---

<p class="meta">
  {
    authors.map((author) => {
      const Tag = author.url ? 'a' : 'span';
      return (
        <Tag {...(author.url ? { href: author.url } : {})}>
          {author.name}
        </Tag>
      );
    })
  }
  <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
  {language && <span class="lang">{language}</span>}
  {minutes && <span>{minutes} min</span>}
</p>
