---
import { formatDate, type Author } from '../lib/site';

interface Props {
  authors?: Author[];
  date: Date;
  language?: string;
}

const { authors = [], date, language } = Astro.props;
---

<div class="post-info">
  {
    authors.map((author) => {
      const Tag = author.url ? 'a' : 'span';
      return (
        <>
          <Tag class="author" {...(author.url ? { href: author.url, target: '_blank', rel: 'noopener' } : {})}>
            {author.avatar && <img alt="Author's avatar" src={author.avatar} class="thumbnail" />}
            {author.name && <span class="name">{author.name}</span>}
          </Tag>
          <span class="spacer"> - </span>
        </>
      );
    })
  }
  <span class="publication-date">{formatDate(date)}</span>
  {
    language && (
      <>
        <span class="spacer"> - </span>
        <span class="publication-language">{language}</span>
      </>
    )
  }
</div>
