---
import './talk.css';
import { authorsOf, formatDate, url, type Entry } from '../lib/site';

interface Props {
  talks: Extract<Entry, { collection: 'talks' }>[];
  filterable?: boolean;
}

const { talks, filterable = false } = Astro.props;
const cards = await Promise.all(talks.map(async (talk) => ({ talk, authors: await authorsOf(talk) })));
const events = [...new Set(talks.map((talk) => talk.data.eventName))].sort();
const years = [...new Set(talks.map((talk) => String(talk.data.date.getUTCFullYear())))].sort((a, b) => Number(b) - Number(a));
---

{
  filterable && (
    <form class="filters">
      <label>
        Event
        <select id="filter-event">
          <option value="">All</option>
          {events.map((event) => <option value={event}>{event}</option>)}
        </select>
      </label>
      <label>
        Year
        <select id="filter-year">
          <option value="">All</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
    </form>
  )
}

<section class="talk-list" id="talk-list">
  {
    cards.map(({ talk, authors }) => (
      <article
        class="talk-card"
        data-event={talk.data.eventName}
        data-year={String(talk.data.date.getUTCFullYear())}
      >
        {talk.data.youtubeId && (
          <a href={url(talk.data.permalink)}>
            <img loading="lazy" src={`https://i.ytimg.com/vi/${talk.data.youtubeId}/hqdefault.jpg`} alt="" />
          </a>
        )}
        <div>
          <h3><a href={url(talk.data.permalink)}>{talk.data.title}</a></h3>
          <p class="meta">
            <span>{talk.data.eventName}</span>
            <time datetime={talk.data.date.toISOString().slice(0, 10)}>{formatDate(talk.data.date)}</time>
            {authors.map((author) => author.name && <span>{author.name}</span>)}
            {talk.data.sponsored && <span class="label label-sponsored">Sponsored</span>}
            {talk.data.hosted && <span class="label label-hosted">Hosted</span>}
          </p>
        </div>
      </article>
    ))
  }
</section>

{
  filterable && (
    <script>
      const eventFilter = document.getElementById('filter-event');
      const yearFilter = document.getElementById('filter-year');
      const apply = () => {
        const eventName = eventFilter instanceof HTMLSelectElement ? eventFilter.value : '';
        const year = yearFilter instanceof HTMLSelectElement ? yearFilter.value : '';
        document.querySelectorAll('#talk-list .talk-card').forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const visible = (!eventName || card.dataset.event === eventName) && (!year || card.dataset.year === year);
          card.hidden = !visible;
        });
      };
      eventFilter?.addEventListener('change', apply);
      yearFilter?.addEventListener('change', apply);
    </script>
  )
}
