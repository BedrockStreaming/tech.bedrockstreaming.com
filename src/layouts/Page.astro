---
import Base from './Base.astro';

interface Props {
  title: string;
  subtitle?: string;
  wide?: boolean;
  featureImage?: string;
  frontmatter?: { title: string; subtitle?: string; featureImage?: string };
}

const props = Astro.props.frontmatter ?? Astro.props;
const { title, subtitle, wide = false } = props;
const echo = (title.match(/[A-Za-zÀ-ÿ0-9]{4,}/) ?? ['Bedrock'])[0];
---

<Base title={title}>
  <slot name="head" slot="head" />
  <header class="page-title">
    <p class="echo" aria-hidden="true">{echo}</p>
    <h1 id={encodeURIComponent(title).replace(/%20/g, '+')} class="title">{title}</h1>
    {subtitle && <p class="lede">{subtitle}</p>}
  </header>
  <div class:list={['page-wrap', { wide }]}>
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>
