---
import Page from '../../layouts/Page.astro';
---

<Page title="Search" subtitle="What are you looking for? The same search opens with ⌘K." wide>
  <div id="page-search"></div>
  <p class="meta" id="page-search-fallback">The search index is generated when the site is built.</p>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (!window.PagefindUI) return;
      new window.PagefindUI({ element: '#page-search', showSubResults: true, showImages: false, autofocus: true });
      document.getElementById('page-search-fallback')?.remove();
    });
  </script>
</Page>
