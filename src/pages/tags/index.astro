---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { formatDate, published, url } from '../../lib/site';

const entries = [...(await published('articles')).reverse(), ...(await published('talks')).reverse()];
const labels = new Map((await getCollection('topics')).map((topic) => [topic.id, topic.data.label]));
const topics = [...labels.keys()].filter((topic) => entries.some((entry) => entry.data.topics.includes(topic)));
---

<Page title="Topics" wide>
  <ul class="chips">
    {topics.map((topic) => (
      <li><a class="chip" href={`#${topic}`}>{labels.get(topic)}</a></li>
    ))}
  </ul>

  {
    topics.map((topic) => (
      <section class="tag-group" id={topic}>
        <h2 class="section-title"><a href={`#${topic}`}>{labels.get(topic) ?? topic}</a></h2>
        <ul>
          {entries
            .filter((entry) => entry.data.topics.includes(topic))
            .map((entry) => (
              <li>
                <a href={url(entry.data.permalink)}>{entry.data.title}</a>
                <span class="meta">
                  <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
                  <span class="lang">{entry.data.language}</span>
                </span>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Page>
